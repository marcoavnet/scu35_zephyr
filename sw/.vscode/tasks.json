{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "app",
      "type": "pickString",
      "description": "Select Zephyr application",
      "options": [
        "myapp_shell",
        "myapp",
        "myapp_net"
      ],
      "default": "myapp_shell"
    }
  ],
  "tasks": [
    {
      "label": "Zephyr: build app",
      "type": "shell",
      "command": "source ${workspaceFolder}/.vscode/env.sh && west build -b mbv32 ${workspaceFolder}/src/${input:app} --build-dir $TRD_HOME/sw/bld/${input:app}",
      "options": {
        "executable": "/bin/bash"
      },
      "problemMatcher": "$gcc",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Zephyr: clean rebuild",
      "type": "shell",
      "command": "source ${workspaceFolder}/.vscode/env.sh && west build -p always -b mbv32 ${workspaceFolder}/src/${input:app} --build-dir $TRD_HOME/sw/bld/${input:app}",
      "options": {
        "executable": "/bin/bash"
      },
      "problemMatcher": "$gcc",
      "group": "build"
    },
    {
      "label": "Zephyr: menuconfig",
      "type": "shell",
      "command": "source ${workspaceFolder}/.vscode/env.sh && west build -t menuconfig --build-dir $TRD_HOME/sw/bld/${input:app}",
      "options": {
        "executable": "/bin/bash"
      },
      "problemMatcher": []
    },
    {
      "label": "Zephyr: ram report",
      "type": "shell",
      "command": "source ${workspaceFolder}/.vscode/env.sh && west build -t ram_report --build-dir $TRD_HOME/sw/bld/${input:app}",
      "options": {
        "executable": "/bin/bash"
      },
      "problemMatcher": []
    },
    {
      "type": "cmake",
      "label": "CMake: clean rebuild",
      "command": "cleanRebuild",
      "targets": [
        "[N/A - Select Kit]"
      ],
      "group": "build",
      "problemMatcher": [],
      "detail": "CMake template clean rebuild task"
    }
  ]
}
