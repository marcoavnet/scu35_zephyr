#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
    leds {
        compatible = "gpio-leds";

        led0: led_0 {
            gpios = <&peripherals_gpio_LEDs 1 GPIO_ACTIVE_HIGH>;
            label = "LED0";
        };
        led1: led_1 {
            gpios = <&peripherals_gpio_LEDs 5 GPIO_ACTIVE_HIGH>;
            label = "LED1";
        };
    };

    aliases {
        led0 = &led0;
        led1 = &led1;
    };

    chosen {
        zephyr,sram  = &microblaze_riscv_0_local_memory_dlmb_bram_if_cntlr_memory;
    };
};

//&microblaze_riscv_0_local_memory_dlmb_bram_if_cntlr_memory {
//    reg = <0x0 0x28000>;
//};


&peripherals_axi_ethernetlite_0 {
    status = "okay";
    mdio {
        #address-cells = <1>;
        #size-cells = <0>;
        phy0: phy@1 {
            device_type = "ethernet-phy";
            reg = <1>;
        };
    };
};

